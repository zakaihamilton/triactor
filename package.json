{
  "name": "triactor",
  "version": "0.1.1",
  "description": "Hierarchical proxy state for React",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zakaihamilton/triactor.git"
  },
  "bugs": {
    "url": "https://github.com/zakaihamilton/triactor/issues"
  },
  "homepage": "https://github.com/zakaihamilton/triactor#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack:check": "npm run build && npm pack --dry-run",
    "health": "repnix check",
    "health:dead-code": "knip",
    "health:duplication": "jscpd src",
    "health:package:publint": "publint",
    "health:package:types": "attw --pack .",
    "health:coverage": "c8 --all --check-coverage --lines 80 --branches 80 --functions 80 --statements 80 --reporter=text npm run test",
    "health:architecture": "depcruise --output-type json --config -- src",
    "health:licenses": "license-checker --json",
    "health:documentation": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#playwright-report\" \"#test-results\" \"#coverage\" \"#dist\" \"#build\" \"#.next\" \"#.turbo\" \"#.git\" \"#generated\"",
    "health:release": "changeset status"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "c8": "^12.0.0",
    "dependency-cruiser": "^18.2.0",
    "jscpd": "^5.0.15",
    "jsdom": "^26.1.0",
    "knip": "^6.32.2",
    "license-checker": "^25.0.1",
    "markdownlint-cli2": "^0.23.2",
    "publint": "^0.3.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "repnix": "^1.0.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
